{
    "name": "migears/pages",
    "description": "Declarative page definitions as PHP arrays, compiled to miGears template files",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "pages",
        "declarative",
        "dsl",
        "template",
        "codegen",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "migears/template": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../migears-template"
        }
    ],
    "autoload": {
        "psr-4": {
            "MiGears\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Pages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "message-coverage": "@php tools/message-coverage.php"
    }
}
